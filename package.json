{
  "name": "mycourses-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for D2L Brightspace (built for RIT myCourses) — check deadlines, read course material, submit assignments and post to discussions from any MCP client",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "brightspace",
    "d2l",
    "valence",
    "lms",
    "rit",
    "mycourses",
    "claude"
  ],
  "license": "MIT",
  "author": "Sahil Dayal",
  "homepage": "https://github.com/sahildayal/mycourses-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahildayal/mycourses-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sahildayal/mycourses-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mycourses-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "login": "node dist/cli.js login",
    "status": "node dist/cli.js status",
    "doctor": "node dist/cli.js doctor",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
