# Brightspace host. Defaults to mycourses.rit.edu when unset.
MYCOURSES_HOST=mycourses.rit.edu

# Auth provider: "session" (browser session, works today) or "oauth"
# (requires a client ID/secret registered by a Brightspace admin).
MYCOURSES_AUTH=session

# Where download_topic_file writes files.
# Defaults to %APPDATA%/mycourses-mcp/downloads
# MYCOURSES_DOWNLOAD_DIR=/path/to/your/downloads

# --- OAuth only: fill these in if RIT ever issues credentials ---
# MYCOURSES_CLIENT_ID=
# MYCOURSES_CLIENT_SECRET=
